config_version=5

[application]

config/name="ZOMBIX HEAD"
config/version="0.13"
run/main_scene="res://world/zona1_rifugio/zombix.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://art/icon.svg"

[autoload]

