var current: String = DEFAULT_LANGUAGE
var _config := ConfigFile.new()


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	_register_translations()
	_load_language()
	_apply_language()


func _register_translations() -> void:
	for language in LANGUAGES:
		var translation := Translation.new()
		translation.locale = str(language.code)
		for table in [MESSAGES, EXTRA_MESSAGES]:
			for key in table:
				var row: Dictionary = table[key]
				if row.has(language.code):
					translation.add_message(key, str(row[language.code]))
		TranslationServer.add_translation(translation)


func _load_language() -> void:
	if _config.load(SAVE_PATH) == OK:
		current = str(_config.get_value("language", "code", DEFAULT_LANGUAGE))
	if not is_language(current):
		current = DEFAULT_LANGUAGE


func _apply_language() -> void:
	TranslationServer.set_locale(current)


func set_language(code: String) -> void:
	if not is_language(code) or code == current:
		return
	current = code
	_apply_language()
	_config.set_value("language", "code", current)
	_config.save(SAVE_PATH)
	language_changed.emit(current)


func language_name(code: String = "") -> String:
	var wanted := code if not code.is_empty() else current
	for language in LANGUAGES:
		if language.code == wanted:
			return str(language.name)
	return "English"


func is_language(code: String) -> bool:
	for language in LANGUAGES:
		if language.code == code:
			return true
	return false


## Traduce un testo sorgente. Se non esiste una voce, restituisce il testo così com'è.
func t(text: String, args: Array = []) -> String:
	var row: Dictionary = MESSAGES.get(text, EXTRA_MESSAGES.get(text, {}))
	var out := str(row.get(current, text))
	if not args.is_empty():
		out = out.format(args)
	return out
